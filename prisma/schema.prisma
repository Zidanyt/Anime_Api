// =============================
// 🔌 Data source e client
// =============================
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================
// 👤 Usuário
// =============================
model User {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String     @unique
  password   String
  profileId  String?    @unique @db.ObjectId // <- ⚠️ Aqui está o ajuste!
  profile    Profile?   @relation(fields: [profileId], references: [id])
  favorites  Favorite[]
  ratings    Rating[]
  createdAt  DateTime   @default(now())
}


// =============================
// 🎬 Anime
// =============================
model Anime {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  image         String
  category      Category?  @relation(fields: [categoryId], references: [id])
  categoryId    String?    @db.ObjectId
  favorites     Favorite[]
  ratings       Rating[]
  createdAt     DateTime   @default(now())

  // Extras
  author        String?    // Criador original
  studio        String?    // Estúdio de animação
  releaseDate   DateTime?  // Data de estreia
  status        String?    // Ex: "Finalizado", "Em exibição"
  episodesCount Int?       // Total de episódios
}

// =============================
// ⭐ Favoritos
// =============================
model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  anime     Anime    @relation(fields: [animeId], references: [id])
  animeId   String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, animeId])
}

// =============================
// 🌟 Avaliações
// =============================
model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  anime     Anime    @relation(fields: [animeId], references: [id])
  animeId   String   @db.ObjectId
  score     Int
  createdAt DateTime @default(now())

  @@unique([userId, animeId])
}

// =============================
// 🏷️ Categorias
// =============================
model Category {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String   @unique
  animes Anime[]
}

model Profile {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  bio    String? // Você pode expandir isso com imagem, localização, etc.
  user   User?
}







