// =============================
// 🔌 Data source e client
// =============================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}


// =============================
// 👤 Usuário
// =============================
model User {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String     @unique
  password   String
  profileId  String?    @unique @db.ObjectId // <- ⚠️ Aqui está o ajuste!
  profile    Profile?   @relation(fields: [profileId], references: [id])
  favorites  Favorite[]
  ratings    Rating[]
  createdAt  DateTime   @default(now())
}

model Anime {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  image         String

  category      Category?  @relation(fields: [categoryId], references: [id])
  categoryId    String?    @db.ObjectId

  favorites     Favorite[]
  ratings       Rating[]

  createdAt     DateTime   @default(now())

  // 📺 Dados do anime
  author        String?
  studio        String?
  releaseDate   DateTime?
  status        String?
  episodesCount Int?
  isNew         Boolean    @default(false)

  // 📚 Dados do mangá
  hasManga      Boolean    @default(false)
  mangaVolumes  Int?
  ownedVolumes  Int        @default(0)
}


// =============================
// ⭐ Favoritos
// =============================
model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  anime     Anime    @relation(fields: [animeId], references: [id])
  animeId   String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, animeId])
}

// =============================
// 🌟 Avaliações
// =============================
model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  anime     Anime    @relation(fields: [animeId], references: [id])
  animeId   String   @db.ObjectId
  score     Int
  createdAt DateTime @default(now())

  @@unique([userId, animeId])
}

model Category {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String  @unique
  animes Anime[]
}


model Profile {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  bio       String?
  avatarUrl String?
  user      User?
}








